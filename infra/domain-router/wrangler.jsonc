{
  "name": "dani-ricco-domain-router",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "daniricco.com.br/*",
      "zone_name": "daniricco.com.br"
    },
    {
      "pattern": "www.daniricco.com.br/*",
      "zone_name": "daniricco.com.br"
    },
    {
      "pattern": "painel.daniricco.com.br",
      "custom_domain": true
    },
    {
      "pattern": "diagnostico.daniricco.com.br",
      "custom_domain": true
    }
  ]
}