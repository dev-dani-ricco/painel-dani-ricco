# Painel Dani Ricco
DATABASE_URL=

# Painel privado - sessão assinada (server-side only)
# Em produção, prefira um segredo aleatório dedicado.
# Se vazio, a aplicação usa DATABASE_URL como fallback de assinatura.
PANEL_AUTH_SECRET=

# Dani Knowledge - AI (server-side only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe

# Vercel Blob
# New Vercel projects can use OIDC automatically.
# For local development with a static token, set:
BLOB_READ_WRITE_TOKEN=
