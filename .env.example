# Painel Dani Ricco
DATABASE_URL=

# Painel privado - sessao assinada (server-side only)
PANEL_AUTH_SECRET=

# Dani Core - runtime de inferencia opcional
# A memoria, classificacao deterministica e PostgreSQL FTS funcionam sem estas variaveis.
# Preferencial: OmniRoute / gateway proprio OpenAI-compatible.
DANI_AI_BASE_URL=
DANI_AI_API_KEY=
DANI_AI_MODEL=openrouter/free
DANI_AI_FAST_MODEL=openrouter/free

# Runtime OpenAI-compatible alternativo, sem dependencia do Vercel AI Gateway.
DANI_OPENAI_COMPAT_BASE_URL=
DANI_OPENAI_COMPAT_API_KEY=

# Embeddings locais do Dani Core sao o padrao e nao usam API paga.
# Use "external" somente se quiser substituir/enriquecer o embedding local.
DANI_EMBEDDING_MODE=local
DANI_EMBEDDING_BASE_URL=
DANI_EMBEDDING_API_KEY=
DANI_EMBEDDING_MODEL=

# Provedor direto opcional para recursos que exigem APIs especificas,
# como transcricao/visao de arquivos enquanto nao houver runtime proprio equivalente.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_FAST_MODEL=gpt-5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe

# Vercel Blob e apenas armazenamento de originais, nao motor de IA.
BLOB_READ_WRITE_TOKEN=
